# Copy this file to config.env and fill it in. config.env is gitignored.

# Your Apple team ID (10 characters). A free personal team works.
# Find it: Xcode → Settings → Accounts → select your Apple ID → Team.
# Or run: security find-identity -v -p codesigning   (the ID in parentheses)
DEVELOPMENT_TEAM=""

# Reverse-DNS prefix that is unique to you, for example com.yourname.glucosewidget
BUNDLE_ID_PREFIX="com.yourname.glucosewidget"

# Full URL of your backend endpoint. See docs/API.md and backend/php/.
GLUCOSE_ENDPOINT="https://example.com/glucose/glucose.php"

# Optional shared secret. Must match API_TOKEN in your backend config.
GLUCOSE_API_TOKEN=""
